esphome:
  name: bluebatteryd1
  friendly_BluebatteryD1

esp32:
  board: esp32dev
  framework:
    type: esp-idf
    advanced:
      flash_chip: generic
      minimum_chip_revision: "3.1"
      sram1_as_iram: true

wifi:
  networks:
    - ssid: !secret wifi_ssid
      password: !secret wifi_password
    - ssid: !secret secondary_wifi_ssid
      password: !secret secondary_wifi_password

  ap:
    ssid: "bluebatteryd1"
    password: !secret fallback_password

captive_portal:

logger:
  level: INFO
  logs:
    esp32_ble_client: WARN
    ble_sensor: WARN

ota:
  platform: esphome
  encryption: {}

api:
  encryption:
    key: !secret api_encryption_key

esp32_ble_tracker:
  scan_parameters:
    interval: 320ms
    window: 30ms
    active: true

ble_client:
  - id: bb_client
    mac_address: "XX:XX:XX:XX:XX:XX"
    on_connect:
      then:
        - lambda: |-
            ESP_LOGI("bb_gatt", "Verbunden mit BlueBattery D1 ;

text_sensor:
  - platform: template
    name: "BlueBattery Info"
    id: bb_info_text

sensor:
  # --- Frame 0x00: Live Messwerte & Leistungen (W) ---
  - platform: template
    name: "BlueBattery Spannung"
    id: bb_voltage
    unit_of_measurement: "V"
    device_class: voltage
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Solarstrom"
    id: bb_solar_current
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Solarleistung"
    id: bb_solar_power
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  - platform: template
    name: "BlueBattery Solarspannung"
    id: bb_solar_voltage
    unit_of_measurement: "V"
    device_class: voltage
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Strom"
    id: bb_current
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Ladeleistung"
    id: bb_charge_power
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  - platform: template
    name: "BlueBattery Entladeleistung"
    id: bb_discharge_power
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  - platform: template
    name: "BlueBattery Land/Motor Ladeleistung"
    id: bb_external_charge_power
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  # --- Frame 0x02: Battery Computer 1 ---
  - platform: template
    name: "BlueBattery Ladung"
    id: bb_charge_ah
    unit_of_measurement: "Ah"
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery SoC"
    id: bb_soc
    unit_of_measurement: "%"
    device_class: battery
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  - platform: template
    name: "BlueBattery Max Strom Heute"
    id: bb_max_curr_day
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Min Strom Heute"
    id: bb_min_curr_day
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Max Ladung Heute"
    id: bb_max_charge_day
    unit_of_measurement: "Ah"
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Min Ladung Heute"
    id: bb_min_charge_day
    unit_of_measurement: "Ah"
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Max Spannung Heute"
    id: bb_max_volt_day
    unit_of_measurement: "V"
    device_class: voltage
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Min Spannung Heute"
    id: bb_min_volt_day
    unit_of_measurement: "V"
    device_class: voltage
    state_class: measurement
    accuracy_decimals: 2
    filters:
      - round: 2

  # --- Frame 0x03: Battery Computer 2 ---
  - platform: template
    name: "BlueBattery Temperatur"
    id: bb_temp
    unit_of_measurement: "°C"
    device_class: temperature
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  - platform: template
    name: "BlueBattery Min Temperatur Heute"
    id: bb_min_temp_day
    unit_of_measurement: "°C"
    device_class: temperature
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  - platform: template
    name: "BlueBattery Max Temperatur Heute"
    id: bb_max_temp_day
    unit_of_measurement: "°C"
    device_class: temperature
    state_class: measurement
    accuracy_decimals: 1
    filters:
      - round: 1

  - platform: template
    name: "BlueBattery Gesamtladen Heute"
    id: bb_total_charge_day
    unit_of_measurement: "Ah"
    state_class: total_increasing
    accuracy_decimals: 2
    filters:
      - round: 2

  - platform: template
    name: "BlueBattery Gesamtentladen Heute"
    id: bb_total_discharge_day
    unit_of_measurement: "Ah"
    state_class: total_increasing
    accuracy_decimals: 2
    filters:
      - round: 2

  # --- Roh-BLE-Sensoren ---
  - platform: ble_client
    type: characteristic
    ble_client_id: bb_client
    id: bb_live
    name: "BlueBattery BCLive Raw"
    service_uuid: "aa021474-780d-439f-af20-6b46446a610e"
    characteristic_uuid: "4b616912-40bd-428b-bf06-698e5e422cd9"
    notify: true
    disabled_by_default: true
    update_interval: 10s
    lambda: |-
      auto read_u16_be = [&](size_t idx) -> uint16_t {
        return (static_cast<uint16_t>(x[idx]) << 8) | static_cast<uint16_t>(x[idx + 1]);
      };
      auto read_u24_be = [&](size_t idx) -> uint32_t {
        return (static_cast<uint32_t>(x[idx]) << 16) |
               (static_cast<uint32_t>(x[idx + 1]) << 8) |
               static_cast<uint32_t>(x[idx + 2]);
      };
      auto read_i24_be = [&](size_t idx) -> int32_t {
        int32_t val = static_cast<int32_t>(read_u24_be(idx));
        if (val & 0x00800000) {
          val |= ~0x00FFFFFF;
        }
        return val;
      };
      auto cnv_temp_c = [&](uint16_t raw_t) -> float {
        return (static_cast<int32_t>(raw_t) - 0x8000) / 100.0f;
      };

      if (x.size() >= 4) {
        uint8_t frame_type = x[0];

        if (frame_type == 0x00 && x.size() >= 9) {
          float voltage_v = read_u16_be(2) / 1000.0f;
          float solar_a = read_u16_be(4) / 1000.0f;
          float batt_a = read_i24_be(6) / 1000.0f;
          float batt_w = voltage_v * batt_a;
          float ext_charge_a = (batt_a > solar_a) ? (batt_a - solar_a) : 0.0f;

          id(bb_voltage).publish_state(voltage_v);
          id(bb_solar_current).publish_state(solar_a);
          id(bb_solar_power).publish_state(voltage_v * solar_a);
          id(bb_solar_voltage).publish_state(0.0f);
          id(bb_current).publish_state(batt_a);
          id(bb_charge_power).publish_state(batt_w > 0.0f ? batt_w : 0.0f);
          id(bb_discharge_power).publish_state(batt_w < 0.0f ? -batt_w : 0.0f);
          id(bb_external_charge_power).publish_state(voltage_v * ext_charge_a);
        } else if (frame_type == 0x01 && x.size() >= 14) {
          uint16_t raw_solar_mv10 = read_u16_be(12);
          if (raw_solar_mv10 > 0) {
            id(bb_solar_voltage).publish_state(raw_solar_mv10 / 100.0f);
          }
        } else if (frame_type == 0x02 && x.size() >= 18) {
          id(bb_charge_ah).publish_state(read_u16_be(2) * 0.01f);
          id(bb_soc).publish_state(read_u16_be(4) / 10.0f);
          id(bb_max_curr_day).publish_state(read_u16_be(6) * 0.01f);
          id(bb_min_curr_day).publish_state(read_u16_be(8) / -10.0f);
          id(bb_max_charge_day).publish_state(read_u16_be(10) * 0.01f);
          id(bb_min_charge_day).publish_state(read_u16_be(12) * 0.01f);
          id(bb_max_volt_day).publish_state(read_u16_be(14) / 1000.0f);
          id(bb_min_volt_day).publish_state(read_u16_be(16) / 1000.0f);
        } else if (frame_type == 0x03 && x.size() >= 14) {
          id(bb_temp).publish_state(cnv_temp_c(read_u16_be(2)));
          id(bb_min_temp_day).publish_state(cnv_temp_c(read_u16_be(4)));
          id(bb_max_temp_day).publish_state(cnv_temp_c(read_u16_be(6)));

          uint32_t raw_total_charge = read_u24_be(8);
          uint32_t raw_total_discharge = read_u24_be(11);
          id(bb_total_charge_day).publish_state((raw_total_charge * (32.0f / 225.0f)) / 1000.0f);
          id(bb_total_discharge_day).publish_state((raw_total_discharge * (32.0f / 225.0f)) / 1000.0f);
        }
      }
      return {};

  - platform: ble_client
    type: characteristic
    ble_client_id: bb_client
    id: bb_char_1c
    name: "BlueBattery Char C3FB"
    service_uuid: "25fb9e91-1616-448d-b5a3-f70a64bda73a"
    characteristic_uuid: "c3fbc9e2-676b-9fb5-3749-2f471dcf07b2"
    notify: true
    disabled_by_default: true
    update_interval: 10s
    lambda: |-
      static std::string line_buf;
      for (uint8_t b : x) {
        if (b == '\n') {
          if (line_buf.find("BlueBasic ") == 0) {
            id(bb_info_text).publish_state(line_buf);
          }
          line_buf.clear();
        } else if (b != '\r') {
          line_buf.push_back(static_cast<char>(b));
        }
      }
      return {};
